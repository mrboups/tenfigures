# Postgres (Railway provides this in production)
DATABASE_URL=postgres://user:pass@host:5432/tenfigures

# Login — set these in Railway variables, never commit real values
AUTH_USERNAME=
AUTH_PASSWORD=

# 32+ character random string for signing the session cookie
SESSION_SECRET=

# 64 hex characters (32 bytes) for AES-256-GCM of exchange API keys
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=

# Optional
PORT=3000
NODE_ENV=development
WORKER_INTERVAL_MS=2500

# Public paper demo only (separate Railway project). Never set on the live terminal.
# DEMO=1
# PUBLIC_BASE=/app
# VITE_BASE=/app/
# PAPER_START_USDT=10000
# GOFUNDME_URL=https://gofund.me/25b7d6563
# RESEND_API_KEY=
# RESEND_FROM="Ten Figures" <info@tenfigures.club>
