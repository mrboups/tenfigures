  "type": "module",
  "description": "Ten Figures trading panel — SmartTrade for CEX spot/futures and Hyperliquid / Lighter perps",
  "homepage": "https://tenfigures.club",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrboups/tenfigures.git"
  },
  "scripts": {
